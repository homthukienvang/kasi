@{
    ViewBag.Title = "Cập nhật hướng dẫn sử dụng cho giáo viên";
}
@model Model.News
<!-- Modal -->
<div id="AddForm"></div>
<div class="row">

</div>

<div class="clear-fix"></div>

<script>
    function removeFile(element) {
        $(element).parent().remove();
    }
    $(document).ready(function () {
        App.Common.UploadFile("#ImageUpload", function (data) {
            $("#ImageUrl").val(data.result.name);
            $("#viewGuilde").text("/Images/" + data.result.name);
        });

    });
</script>
<div class="form-group">
    <div class="col-xs-12">
        <div class="table-responsive">

            @using (Html.BeginForm("UserGuide", "News", FormMethod.Post, new { @id = "UserGuide" }))
            {
                @Html.ValidationSummary(true)
                <div class="row">
                    <div class="form-group col-md-12">
                        <label class="control-label  col-xs-12"> Tiêu đề</label>
                        <div class="col-xs-12">
                            @Html.HiddenFor(x => x.NewsId, new { @class = "form-control", @placeholder = " Name" })
                            @Html.TextBoxFor(x => x.Title, new { @class = "form-control", @placeholder = " Name" })
                        </div>
                    </div>
                </div>
                <div class="clear-fix"></div>
                <div class="row">
                    <div class="form-group col-md-12">
                        <label class="control-label col-xs-12"> Nội dung hướng dẫn</label>
                        <div class="col-xs-2">
                            @Html.HiddenFor(x => x.Description, new { @class = "form-control", @rows = 12 })

                            <div id="ImageUpload">
                                @Html.HiddenFor(x => x.ImageUrl, new { @class = "form-control" })
                                <span class="btn btn-sm btn-primary fileinput-button">
                                    <i class="fa fa-plus-circle"></i> Cập nhật file mới
                                    <input id="fileuploadIcon" class="fileupload" type="file" name="files[]" accept=".pdf,.PDF">
                                </span>
                                <div class="progress" style="display: none">
                                    <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 60%;">
                                        <span class="sr-only">0% Complete</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-8">
                            <div class="file_name"></div>
                            <label id="viewGuilde" class="form-group form-control">@string.Format("/Images/{0}", Model.ImageUrl)</label>
                        </div>
                        <div class="col-xs-2">
                            <a href="@string.Format("/Images/{0}", Model.ImageUrl)" target="_blank" class="btn btn-xs default">Tải về <i class="fa fa-download"></i></a>
                        </div>
                        <div class="clear-fix"></div>
                    </div>
                </div>
                <div class="clear-fix"></div>

                <div class="row">
                    <div class="col-xs-12">
                        <label id="errormsg" class="error"></label>
                        <button type="submit" class="btn btn-default btn-success">
                            <i class="fa fa-save"></i> Lưu
                        </button>
                    </div>
                </div>
            }

        </div><!-- /.table-responsive -->
    </div><!-- /span -->
</div><!-- /row -->

<div class="hr hr-18 dotted hr-double"></div>
