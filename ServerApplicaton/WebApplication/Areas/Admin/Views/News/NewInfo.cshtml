@{
    ViewBag.Title = "Quản lý thông báo";
}
@model Model.News
<!-- Modal -->
<div id="AddForm"></div>
<div class="row">

</div>
<style>
    .validation-summary-errors {
        color: red;
        font-weight: bold;
        list-style-type: none;
    }
</style>
<div class="clear-fix"></div>

<div class="row">
    <div class="col-xs-12">
        <div class="table-responsive">

            @using (Html.BeginForm("NewInfo", "News", FormMethod.Post, new { @id = "NewInfo" }))
            {
                <div class="">
                    @Html.ValidationSummary(true)
                    <div>
                        <div class="row">
                            <div class="form-group col-md-12">
                                <label class="control-label  col-xs-12"> Tiêu đề</label>
                                <div class="col-xs-12">
                                    @Html.HiddenFor(x => x.NewsId, new { @class = "form-control", @placeholder = " Name" })
                                    @Html.TextBoxFor(x => x.Title, new { @class = "form-control", @placeholder = " Name" })
                                </div>
                            </div>
                        </div>
                        <div class="clear-fix"></div>
                        <div class="row">
                            <div class="form-group col-md-12">
                                <label class="control-label  col-xs-12"> Nội dung thông báo</label>
                                <div class="col-xs-12">
                                    @Html.HiddenFor(x => x.ImageUrl, new { @class = "form-control", @placeholder = " Name" })
                                    @Html.TextAreaFor(x => x.Description, new { @class = "form-control", @maxlength = "4000", @rows = 12 })
                                </div>
                            </div>
                        </div>
                        <div class="clear-fix"></div>
                    </div>


                </div>
                <div class="pull-right">
                    <label id="errormsg" class="error" style="display: inline-block;"></label>

                    <button type="submit" class="btn btn-default btn-success ">
                        <i class="fa fa-save"></i> Lưu
                    </button>
                </div>
            }

        </div><!-- /.table-responsive -->
    </div><!-- /span -->
</div><!-- /row -->

<div class="hr hr-18 dotted hr-double"></div>

<script type="text/javascript">
    $(document).on("ready", function () {
        CKEDITOR.replace('Description', {
            toolbar : 
                [{ name: 'styles', items: ['Bold', 'Italic', 'Underline', 'Link', 'Unlink'] }],
            entities : false,
            basicEntities: false,
            filebrowserBrowseUrl: '',
            extraPlugins : '',
            language : 'vi',
            uiColor : '#fdfdfd',
            height : '250px',
            fillEmptyBlocks : false,
            removePlugins : 'wsc,scayt,image,exportpdf',
            enterMode : CKEDITOR.ENTER_BR,
            allowedContent : true,
            forcePasteAsPlainText : true,
            pasteFromWordRemoveStyles : true,
            pasteFromWordRemoveFontStyles : true,
            ignoreEmptyParagraph : true,
            extraAllowedContent : 'br strong i(*)[*] em u',
            disallowedContent : 'script *(style) style',
        });
    });
</script>